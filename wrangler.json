{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bs-proxy-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
